{
  "id": "com.crewpoppy.desktop",
  "name": "CrewPoppy",
  "version": "0.1.0",
  "description": "Mission Control for your AI crew — task-specific AI agents that run entirely in your own AWS, with hard spend caps and every action visible.",
  "icon": "frontend/crewpoppy-icon.png",
  "permissionSet": {
    "id": "crewpoppy-backend",
    "name": "CrewPoppy backend",
    "description": "Deploys and removes its own CloudFormation stack (CrewPoppyStack): the agents table, the agent workspace bucket, the agent-runner function and its execution role. Every change and delete is limited to resources named CrewPoppy*/crewpoppy-* — it cannot touch anything else in your account. The one role it creates is the runner's own, name-locked to CrewPoppy*, and only that role can invoke AI models (Bedrock) — billed to your AWS, capped by CrewPoppy's spend limits.",
    "requiredTags": ["agentspoppy:account", "agentspoppy:app", "agentspoppy:connection"],
    "grants": [
      {
        "service": "cloudformation",
        "actions": [
          "CreateStack",
          "UpdateStack",
          "DeleteStack",
          "DescribeStacks",
          "DescribeStackEvents",
          "DescribeStackResources"
        ],
        "resourceScope": "arn:aws:cloudformation:*:*:stack/CrewPoppyStack/*"
      },
      {
        "service": "dynamodb",
        "actions": [
          "CreateTable",
          "DeleteTable",
          "DescribeTable",
          "UpdateTimeToLive",
          "DescribeTimeToLive",
          "TagResource",
          "ListTagsOfResource"
        ],
        "resourceScope": "arn:aws:dynamodb:*:*:table/CrewPoppy*"
      },
      {
        "service": "s3",
        "actions": ["CreateBucket", "DeleteBucket", "PutBucketTagging", "PutBucketPublicAccessBlock", "ListBucket"],
        "resourceScope": "arn:aws:s3:::crewpoppy-*"
      },
      {
        "service": "s3",
        "actions": ["PutObject", "GetObject", "DeleteObject"],
        "resourceScope": "arn:aws:s3:::crewpoppy-*/*"
      },
      {
        "service": "lambda",
        "actions": [
          "CreateFunction",
          "DeleteFunction",
          "GetFunction",
          "UpdateFunctionCode",
          "UpdateFunctionConfiguration",
          "TagResource",
          "ListTags"
        ],
        "resourceScope": "arn:aws:lambda:*:*:function:CrewPoppy*"
      },
      {
        "service": "iam",
        "actions": [
          "CreateRole",
          "DeleteRole",
          "GetRole",
          "PutRolePolicy",
          "DeleteRolePolicy",
          "GetRolePolicy",
          "PassRole",
          "TagRole"
        ],
        "resourceScope": "arn:aws:iam::*:role/CrewPoppy*"
      },
      {
        "service": "logs",
        "actions": [
          "CreateLogGroup",
          "DeleteLogGroup",
          "DescribeLogGroups",
          "PutRetentionPolicy",
          "TagResource",
          "ListTagsForResource"
        ],
        "resourceScope": "arn:aws:logs:*:*:log-group:/aws/lambda/CrewPoppy*"
      }
    ],
    "limits": null
  },
  "frontend": {
    "entry": "frontend/index.html"
  },
  "backend": {
    "entry": "backend/crewpoppy-sidecar",
    "transport": "http"
  },
  "teardown": {
    "endpoint": "/teardown"
  },
  "capabilities": ["aws:credentials", "connection:read", "backend:invoke"]
}
