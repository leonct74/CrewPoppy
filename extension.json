{
  "id": "com.crewpoppy.desktop",
  "name": "CrewPoppy",
  "version": "0.1.0",
  "description": "The HQ for your AI crew \u2014 task-specific AI agents that run entirely in your own AWS, with hard spend caps and every action visible.",
  "icon": "frontend/crewpoppy-icon.png",
  "permissionSet": {
    "id": "crewpoppy-backend",
    "name": "CrewPoppy backend",
    "description": "Deploys and removes its own CloudFormation stack (CrewPoppyStack): the agents table, the agent workspace bucket, the agent-runner function and its execution role. Every change and delete is limited to resources named CrewPoppy*/crewpoppy-* \u2014 it cannot touch anything else in your account. The one role it creates is the runner's own, name-locked to CrewPoppy*, and only that role can invoke AI models (Bedrock) \u2014 billed to your AWS, capped by CrewPoppy's spend limits. If you let an agent send email, that role can also send from addresses you have ALREADY verified in SES \u2014 it can never verify a new one, and CrewPoppy refuses to send to anyone but you until you approve that exact message. Here it only READS whether an address is verified.",
    "requiredTags": [
      "agentspoppy:account",
      "agentspoppy:app",
      "agentspoppy:connection"
    ],
    "grants": [
      {
        "service": "cloudformation",
        "actions": [
          "CreateStack",
          "UpdateStack",
          "DeleteStack",
          "DescribeStacks",
          "DescribeStackEvents",
          "DescribeStackResources"
        ],
        "resourceScope": "arn:aws:cloudformation:*:*:stack/CrewPoppyStack/*"
      },
      {
        "service": "dynamodb",
        "actions": [
          "CreateTable",
          "DeleteTable",
          "DescribeTable",
          "UpdateTimeToLive",
          "DescribeTimeToLive",
          "TagResource",
          "ListTagsOfResource",
          "GetItem",
          "PutItem",
          "UpdateItem",
          "DeleteItem",
          "Query"
        ],
        "resourceScope": "arn:aws:dynamodb:*:*:table/CrewPoppy*"
      },
      {
        "service": "s3",
        "actions": [
          "CreateBucket",
          "DeleteBucket",
          "PutBucketTagging",
          "PutBucketPublicAccessBlock",
          "ListBucket"
        ],
        "resourceScope": "arn:aws:s3:::crewpoppy-*"
      },
      {
        "service": "s3",
        "actions": [
          "PutObject",
          "GetObject",
          "DeleteObject"
        ],
        "resourceScope": "arn:aws:s3:::crewpoppy-*/*"
      },
      {
        "service": "lambda",
        "actions": [
          "CreateFunction",
          "DeleteFunction",
          "GetFunction",
          "UpdateFunctionCode",
          "UpdateFunctionConfiguration",
          "TagResource",
          "ListTags",
          "InvokeFunction",
          "AddPermission",
          "RemovePermission",
          "GetPolicy",
          "CreateFunctionUrlConfig",
          "GetFunctionUrlConfig",
          "UpdateFunctionUrlConfig",
          "DeleteFunctionUrlConfig"
        ],
        "resourceScope": "arn:aws:lambda:*:*:function:CrewPoppy*"
      },
      {
        "service": "iam",
        "actions": [
          "CreateRole",
          "DeleteRole",
          "GetRole",
          "PutRolePolicy",
          "DeleteRolePolicy",
          "GetRolePolicy",
          "PassRole",
          "TagRole"
        ],
        "resourceScope": "arn:aws:iam::*:role/CrewPoppy*"
      },
      {
        "service": "bedrock",
        "actions": [
          "GetFoundationModelAvailability"
        ],
        "resourceScope": "arn:aws:bedrock:*::foundation-model/*"
      },
      {
        "service": "ses",
        "actions": [
          "GetEmailIdentity"
        ],
        "resourceScope": "arn:aws:ses:*:*:identity/*"
      },
      {
        "service": "events",
        "actions": [
          "PutRule",
          "DeleteRule",
          "DescribeRule",
          "PutTargets",
          "RemoveTargets",
          "ListTargetsByRule",
          "TagResource",
          "ListTagsForResource"
        ],
        "resourceScope": "arn:aws:events:*:*:rule/CrewPoppy*"
      },
      {
        "service": "logs",
        "actions": [
          "CreateLogGroup",
          "DeleteLogGroup",
          "PutRetentionPolicy",
          "TagResource",
          "ListTagsForResource"
        ],
        "resourceScope": "arn:aws:logs:*:*:log-group:/aws/lambda/CrewPoppy*"
      },
      {
        "service": "cognito-idp",
        "actions": [
          "CreateUserPool",
          "CreateUserPoolClient",
          "DescribeUserPool",
          "DescribeUserPoolClient",
          "ListUsers"
        ],
        "resourceScope": "arn:aws:cognito-idp:*:*:userpool/*",
        "reason": "The mobile app's login (P4): one user pool holding ONE user \u2014 the owner. Creates carry the attribution tags at birth (CreateUserPool's own Tags field \u2014 no separate tagging action); pool ids are generated, so creates can't be name-scoped narrower."
      },
      {
        "service": "cognito-idp",
        "actions": [
          "DeleteUserPool",
          "UpdateUserPool",
          "DeleteUserPoolClient",
          "UpdateUserPoolClient",
          "AdminCreateUser",
          "AdminSetUserPassword",
          "AdminDeleteUser"
        ],
        "resourceScope": "tagged-as-self",
        "reason": "Managing that same pool and its single owner account \u2014 only on pools CrewPoppy itself created (tag-enforced), incl. teardown."
      }
    ],
    "limits": null
  },
  "frontend": {
    "entry": "frontend/index.html"
  },
  "backend": {
    "entry": "backend/index.cjs",
    "transport": "http",
    "runtime": "node22"
  },
  "teardown": {
    "endpoint": "/teardown"
  },
  "capabilities": [
    "aws:credentials",
    "connection:read",
    "backend:invoke",
    "host:openExternal"
  ]
}
